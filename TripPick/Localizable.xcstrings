      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観モード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 모드"
          }
        }
      }
    },
    "Best": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천"
          }
        }
      }
    },
    "Best album": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベストアルバム"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "베스트 앨범"
          }
        }
      }
    },
    "Blurry": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔들림"
          }
        }
      }
    },
    "Blurry or dark": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレ・暗い写真"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔들림·어두움"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "Choose the dates of a trip. TripPick groups similar shots and flags blurry ones so you only have to pick.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行の日付を選んでください。似た写真をまとめ、ブレた写真に印を付けるので、選ぶだけで済みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 날짜를 고르세요. 비슷한 사진은 묶고 흔들린 사진은 표시해 두니, 고르기만 하면 됩니다."
          }
        }
      }
    },
    "Compare": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교"
          }
        }
      }
    },
    "Continue organizing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続きから整理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어서 정리하기"
          }
        }
      }
    },
    "Couldn't find place names": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所の名前が見つかりませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소 이름을 찾지 못했어요"
          }
        }
      }
    },
    "Couldn't update your photo library. Try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリを更新できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 보관함을 바꾸지 못했어요. 다시 시도해 주세요."
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダーク"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다크"
          }
        }
      }
    },
    "Delete later": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除候補"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지울 후보"
          }
        }
      }
    },
    "Deleted photos stay in Recently Deleted for 30 days, so you can still recover them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除した写真は30日間「最近削除した項目」に残るので、復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지운 사진은 30일 동안 \"최근 삭제된 항목\"에 남아 있어서 되살릴 수 있어요."
          }
        }
      }
    },
    "Deleting a photo also removes it from other albums and shared albums.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を削除すると、ほかのアルバムや共有アルバムからも消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 지우면 다른 앨범과 공유 앨범에서도 사라져요."
          }
        }
      }
    },
    "Deletion was canceled. Your albums are ready.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除をキャンセルしました。アルバムは作成済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제를 취소했어요. 앨범은 만들어졌어요."
          }
        }
      }
    },
    "Don't keep": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残さない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남기지 않음"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "End": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝"
          }
        }
      }
    },
    "Every group in this list is decided.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリストのグループはすべて決定済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 목록의 묶음을 모두 정했어요."
          }
        }
      }
    },
    "Everything happens on this iPhone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての処理はこのiPhoneの中で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 분석은 이 iPhone 안에서 이루어집니다."
          }
        }
      }
    },
    "Eyes closed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目つぶり"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈 감음"
          }
        }
      }
    },
    "Favorite": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기"
          }
        }
      }
    },
    "In each group, the sharpest and best-looking photo starts out selected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループで、いちばん鮮明でよく撮れた写真が最初から選択されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "묶음마다 가장 선명하고 잘 나온 사진이 미리 선택됩니다."
          }
        }
      }
    },
    "Keep": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남기기"
          }
        }
      }
    },
    "Keep %lld · mark %lld for deletion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep %1$lld · mark %2$lld for deletion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld枚を残し、%2$lld枚を削除候補に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld장 남기고 %2$lld장은 지울 후보로"
          }
        }
      }
    },
    "Keep all %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld枚すべて残す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld장 모두 남기기"
          }
        }
      }
    },
    "Keep this": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを残す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이걸 남기기"
          }
        }
      }
    },
    "Keeping": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
