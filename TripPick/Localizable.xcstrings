    "Choose the dates of a trip. TripPick groups similar shots and flags blurry ones so you only have to pick.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行の日付を選んでください。似た写真をまとめ、ブレた写真に印を付けるので、選ぶだけで済みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 날짜를 고르세요. 비슷한 사진은 묶고 흔들린 사진은 표시해 두니, 고르기만 하면 됩니다."
          }
        }
      }
    },
    "Compare": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교"
          }
        }
      }
    },
    "Continue organizing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続きから整理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어서 정리하기"
          }
        }
      }
    },
    "Dark": {
