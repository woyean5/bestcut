    "Your photos are analyzed on this iPhone and never leave it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はこのiPhoneの中だけで分析され、外に送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 이 iPhone 안에서만 분석되고 밖으로 나가지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片只在这台 iPhone 上分析，绝不会离开设备。"
          }
        }
      }
    },
    "Your photos may have no location, or you may be offline.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に位置情報がないか、インターネットに接続されていない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진에 위치 정보가 없거나 인터넷에 연결되어 있지 않을 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片可能没有位置信息，或者你未连接网络。"
          }
        }
      }
    },
    "photos in your best album": {
      "localizations": {
