    "Album names follow this language too.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバム名もこの言語で作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범 이름도 이 언어로 만들어져요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相簿名称也会使用此语言。"
          }
        }
      }
    },
    "Albums are ready in Photos.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリにアルバムを作成しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에 앨범을 만들었어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在“照片”中创建相簿。"
          }
        }
      }
    },
    "Albums are ready, and %lld items were deleted.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Albums are ready, and %lld item was deleted."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Albums are ready, and %lld items were deleted."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムを作成し、%lld件を削除しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범을 만들고 %lld개를 지웠어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已创建相簿，并删除了 %lld 项。"
          }
        }
      }
    },
    "All done here": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここは整理済みです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기는 다 정리했어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里已全部整理完"
          }
        }
      }
    },
    "All picked": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選び終わりました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 골랐어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部选好了"
          }
        }
      }
    },
    "Allow photo access": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真へのアクセスを許可"
