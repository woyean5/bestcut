            "state": "translated",
            "value": "취소"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Compare": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較"
          }
        },
        "ko": {
          "stringUnit": {
