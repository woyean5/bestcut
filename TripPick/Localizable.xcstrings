          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对比"
          }
        }
      }
    },
    "Continue organizing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続きから整理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어서 정리하기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续整理"
          }
        }
      }
    },
    "Couldn't find place names": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所の名前が見つかりませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소 이름을 찾지 못했어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能找到地点名称"
          }
        }
      }
    },
    "Couldn't update your photo library. Try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリを更新できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 보관함을 바꾸지 못했어요. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新照片图库，请重试。"
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダーク"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다크"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色"
          }
        }
      }
    },
    "Delete later": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除候補"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지울 후보"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待删除"
          }
        }
      }
    },
    "Deleted photos stay in Recently Deleted for 30 days, so you can still recover them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除した写真は30日間「最近削除した項目」に残るので、復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지운 사진은 30일 동안 \"최근 삭제된 항목\"에 남아 있어서 되살릴 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除的照片会在“最近删除”中保留 30 天，仍可恢复。"
          }
        }
      }
    },
    "Deleting a photo also removes it from other albums and shared albums.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を削除すると、ほかのアルバムや共有アルバムからも消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 지우면 다른 앨범과 공유 앨범에서도 사라져요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除照片后，它也会从其他相簿和共享相簿中移除。"
          }
        }
