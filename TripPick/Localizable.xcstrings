    "%lld%% organized": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% 整理済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% 정리함"
          }
        }
      }
    },
    "About %@ can be freed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約%@ 空けられます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %@ 비울 수 있어요"
          }
        }
      }
    },
    "Album names follow this language too.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバム名もこの言語で作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범 이름도 이 언어로 만들어져요."
          }
        }
      }
    },
    "Albums are ready in Photos.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリにアルバムを作成しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에 앨범을 만들었어요."
          }
        }
      }
    },
    "Albums are ready, and %lld items were deleted.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Albums are ready, and %lld item was deleted."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Albums are ready, and %lld items were deleted."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムを作成し、%lld件を削除しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범을 만들고 %lld개를 지웠어요."
          }
        }
      }
    },
    "All done here": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここは整理済みです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기는 다 정리했어요"
          }
        }
      }
    },
    "All picked": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選び終わりました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 골랐어요"
          }
        }
      }
    },
    "Allow photo access": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真へのアクセスを許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 접근 허용"
          }
        }
      }
    },
