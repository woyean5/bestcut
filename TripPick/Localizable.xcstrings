            "state": "translated",
            "value": "즐겨찾기"
          }
        }
      }
    },
    "In each group, the sharpest and best-looking photo starts out selected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループで、いちばん鮮明でよく撮れた写真が最初から選択されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "묶음마다 가장 선명하고 잘 나온 사진이 미리 선택됩니다."
          }
        }
      }
    },
    "Keep": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残す"
          }
        },
        "ko": {
