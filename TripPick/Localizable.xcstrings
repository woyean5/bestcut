    "Every group in this list is decided.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリストのグループはすべて決定済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 목록의 묶음을 모두 정했어요."
          }
        }
      }
    },
    "Everything happens on this iPhone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての処理はこのiPhoneの中で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 분석은 이 iPhone 안에서 이루어집니다."
          }
        }
      }
    },
    "Eyes closed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目つぶり"
          }
        },
        "ko": {
