        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어"
          }
        }
      }
    },
    "Left as they are": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのまま"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그대로 둠"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이트"
          }
        }
      }
    },
    "Long-press another photo to compare": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比べる写真をもう1枚長押ししてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교할 사진을 하나 더 길게 누르세요"
          }
        }
      }
    },
    "Long-press two photos to compare them": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
