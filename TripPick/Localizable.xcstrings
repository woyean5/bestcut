{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        }
      }
    },
    "%lld photos · %lld short videos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld photos · %2$lld short videos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真%1$lld枚・短い動画%2$lld本"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 %1$lld장 · 짧은 동영상 %2$lld개"
          }
        }
      }
    },
    "%lld sec or less": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld秒以下"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld초 이하"
          }
        }
      }
    },
    "Allow photo access": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真へのアクセスを許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 접근 허용"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観モード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 모드"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "Choose the dates of a trip. TripPick groups similar shots and flags blurry ones so you only have to pick.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行の日付を選んでください。似た写真をまとめ、ブレた写真に印を付けるので、選ぶだけで済みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 날짜를 고르세요. 비슷한 사진은 묶고 흔들린 사진은 표시해 두니, 고르기만 하면 됩니다."
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダーク"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다크"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "End": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝"
          }
        }
      }
    },
    "Everything happens on this iPhone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての処理はこのiPhoneの中で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 분석은 이 iPhone 안에서 이루어집니다."
          }
        }
      }
    },
    "In each group, the sharpest and best-looking photo starts out selected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループで、いちばん鮮明でよく撮れた写真が最初から選択されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "묶음마다 가장 선명하고 잘 나온 사진이 미리 선택됩니다."
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이트"
          }
        }
      }
    },
    "Looking through your photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を確認しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 살펴보는 중"
          }
        }
      }
    },
    "New trip": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい旅行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 여행"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 열기"
          }
        }
      }
    },
    "Organize a new trip": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい旅行を整理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 여행 정리"
          }
        }
      }
    },
    "Organize your first trip": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の旅行を整理しましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 여행을 정리해 보세요"
          }
        }
      }
    },
    "Photo access is off": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真へのアクセスがオフです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 접근이 꺼져 있어요"
          }
        }
      }
    },
    "Pick your best travel shots": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行のベストショットだけを選びましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 베스트 컷만 골라 보세요"
          }
        }
      }
    },
    "Select more photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をさらに選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 더 선택"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정"
          }
        }
      }
    },
    "Short videos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い動画"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 동영상"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작"
          }
        }
      }
    },
    "Start organizing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理を始める"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 시작"
          }
        }
      }
    },
    "Suggest the best shot": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめ写真を自動で選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 사진 자동 선택"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템"
          }
        }
      }
    },
    "The end date is before the start date.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了日が開始日より前になっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝 날짜가 시작 날짜보다 앞서 있어요."
          }
        }
      }
    },
    "There are no photos on these dates.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間には写真がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간에는 사진이 없어요."
          }
        }
      }
    },
    "TripPick": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TripPick"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TripPick"
          }
        }
      }
    },
    "TripPick finds blurry shots and groups similar photos so you only have to pick. Your photos are analyzed on this iPhone and never leave it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレた写真を見つけ、似た写真をまとめるので、選ぶだけで済みます。写真はこのiPhoneの中だけで分析され、外に送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔들린 사진을 찾아 표시하고 비슷한 사진을 묶어 드려요. 고르기만 하면 됩니다. 사진은 이 iPhone 안에서만 분석되고 밖으로 나가지 않아요."
          }
        }
      }
    },
    "TripPick needs access to your photos to find blurry shots and group similar ones. You can turn it on in Settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレた写真を見つけて似た写真をまとめるには、写真へのアクセスが必要です。設定でオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔들린 사진을 찾고 비슷한 사진을 묶으려면 사진 접근 권한이 필요해요. 설정에서 켤 수 있어요."
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전"
          }
        }
      }
    },
    "Videos this short are often taken by accident. Longer videos aren't shown.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このくらい短い動画は誤って撮影されたことが多いです。これより長い動画は表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 짧은 동영상은 실수로 찍힌 경우가 많아요. 더 긴 동영상은 보이지 않아요."
          }
        }
      }
    },
    "Which trip should we organize?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの旅行を整理しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 여행을 정리할까요?"
          }
        }
      }
    },
    "You've shared only some photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の写真だけが共有されています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 사진만 공유되어 있어요"
          }
        }
      }
    },
    "Your photos are analyzed on this iPhone and never leave it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はこのiPhoneの中だけで分析され、外に送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 이 iPhone 안에서만 분석되고 밖으로 나가지 않아요."
          }
        }
      }
    },
    "Your trips": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行一覧"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 여행"
          }
        }
      }
    }
  },
  "version": "1.0"
}