            "value": "추천"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐"
          }
        }
      }
    },
    "Best album": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベストアルバム"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "베스트 앨범"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精选相簿"
          }
        }
      }
    },
    "BestCut": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベストカット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "베스트컷"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BestCut"
          }
        }
      }
    },
    "BestCut finds blurry shots and groups similar photos so you only have to pick. Your photos are analyzed on this iPhone and never leave it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレた写真を見つけ、似た写真をまとめるので、選ぶだけで済みます。写真はこのiPhoneの中だけで分析され、外に送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔들린 사진을 찾아 표시하고 비슷한 사진을 묶어 드려요. 고르기만 하면 됩니다. 사진은 이 iPhone 안에서만 분석되고 밖으로 나가지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BestCut 会找出模糊的照片并把相似照片归为一组，你只需挑选即可。照片只在这台 iPhone 上分析，绝不会离开设备。"
          }
        }
      }
    },
    "BestCut needs access to your photos to find blurry shots and group similar ones. You can turn it on in Settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレた写真を見つけて似た写真をまとめるには、写真へのアクセスが必要です。設定でオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔들린 사진을 찾고 비슷한 사진을 묶으려면 사진 접근 권한이 필요해요. 설정에서 켤 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BestCut 需要访问你的照片，才能找出模糊照片并整理相似照片。你可以在“设置”中开启。"
          }
        }
      }
    },
    "Blurry": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔들림"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊"
          }
        }
      }
    },
    "Blurry or dark": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレ・暗い写真"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔들림·어두움"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊或过暗"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "ko": {
