      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BestCut looks at your photos on this iPhone to find blurry shots and similar photos. Your photos never leave your device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブレた写真や似た写真を見つけるために、このiPhoneの写真を確認します。写真が端末の外に送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔들린 사진과 비슷한 사진을 찾기 위해 이 iPhone의 사진을 살펴봅니다. 사진은 기기 밖으로 나가지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BestCut 会查看这台 iPhone 上的照片，以找出模糊和相似的照片。你的照片绝不会离开设备。"
          }
        }
      }
    }
  },
  "version": "1.0"
}